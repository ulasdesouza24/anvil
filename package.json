{
  "name": "anvil",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Anvil — an agentic system that builds, tests and evolves agents as typed JSON workflows.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "anvil": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm test",
    "mcp": "tsx src/mcp-stdio.ts",
    "bench": "tsx src/bench/cli.ts",
    "sandbox:build": "docker build -t anvil-sandbox:py312 sandbox"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.13.9",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^7.0.13",
    "playwright-core": "^1.63.0",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.12.0",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.48.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
