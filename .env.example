# Required
OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# ANVIL_LLM_MODEL=z-ai/glm-5.3-flash
# ANVIL_DECISION_MODEL=typesafe/jev-1.13
# ANVIL_TIERS={"fast":{"reasoning":"low"},"balanced":{"reasoning":"medium"},"deep":{"reasoning":"high"}}
# ANVIL_PORT=8787
# ANVIL_DATA_DIR=./data
# ANVIL_CONFIDENCE_THRESHOLD=0.6
# ANVIL_EVOLVE_TARGET=0.85
# ANVIL_EVOLVE_MAX_ROUNDS=2
# ANVIL_REPAIR_MAX_ATTEMPTS=4
# ANVIL_MAX_PARALLEL=8

# Decision thresholds (probabilities from the decision model, 0 to 1)
# ANVIL_TH_DIAGNOSIS_CONFIDENCE=0.6    # evolve acts on a failure diagnosis at this confidence; below it, a second opinion runs
# ANVIL_TH_INTENT_KEEP=0.5             # an evolve candidate must keep the meaning of the request with this probability
# ANVIL_TH_ACCEPTANCE_JUDGE=0.5        # a judge rule of the definition of done passes at this probability
# ANVIL_TH_CRITERION_PASS=0.5          # a test criterion passes at this probability
# ANVIL_TH_SOURCE_RELEVANCE=0.5        # a data source sample must be this relevant
# ANVIL_TH_LIBRARY_MATCH=0.6           # a library class must match a data need with this probability
# ANVIL_TH_EVOLVE_MIN_GAIN=0.005       # the score gain that an evolve candidate needs with the same pass rate
# ANVIL_TH_EVOLVE_SCORE_TOLERANCE=0.02 # the score loss that a candidate may have when its pass rate is higher
# ANVIL_TH_CLARIFY_BELOW=0.5           # below this clarity, the builder asks its questions
# ANVIL_TH_PLAN_COMPLETE=0.5           # the architect plan is reviewed again below this completeness
# ANVIL_TH_PLAN_MINIMAL=0.35           # the architect plan is reviewed again below this minimality
# ANVIL_TH_TRIAGE_FLAG=0.5             # a yes/no triage flag counts as yes above this probability

# Source score weights: score = relevance x (1 - freshness + freshness x sample freshness) x factors + bonuses
# ANVIL_SW_FRESHNESS=0.5        # the share of the score that freshness controls
# ANVIL_SW_BROWSER_FACTOR=0.9   # the factor for a source that needs the browser
# ANVIL_SW_TEXT_FACTOR=0.9      # the factor for a source that gives page text, not JSON fields
# ANVIL_SW_LIBRARY_BONUS=0.05   # the bonus for a tested class from the library
# ANVIL_SW_NAMED_BONUS=1        # the bonus for a URL that the request names

# Python sandbox (docs/SANDBOX.md)
# ANVIL_SANDBOX=docker                     # docker or off
# ANVIL_SANDBOX_IMAGE=anvil-sandbox:py312  # npm run sandbox:build
# ANVIL_SANDBOX_NETWORK=isolated           # isolated (tool bridge and package gate only), allowlist (direct HTTP to allowed domains), open (development only)
# ANVIL_SANDBOX_POOL=2                     # containers kept ready
# ANVIL_SANDBOX_TIMEOUT_MS=60000           # time limit for each program
# ANVIL_SANDBOX_MEMORY=512m
# ANVIL_SANDBOX_CPUS=1
# ANVIL_SANDBOX_MAX_OUTPUT=1000000
# ANVIL_PACKAGE_INDEX=https://pypi.org/simple   # or a company mirror, for example a Nexus PyPI repository
# ANVIL_PACKAGE_VULN_CHECK=osv             # osv or off (for example when Nexus already checks)
# ANVIL_PACKAGE_ALLOW=                     # comma-separated projects; when set, only these install
# ANVIL_PACKAGE_DENY=                      # comma-separated projects that never install
# ANVIL_PACKAGE_GATE_PORT=3141             # a free port is used when another process has it
# ANVIL_EGRESS_MAX_BODY=65536              # bytes that one outbound request of a program can send
# ANVIL_SANDBOX_MAX_SECONDS_PER_RUN=300       # sandbox time for all programs of one run
# ANVIL_SW_COVERAGE=0.7              # the share of the source score that the field coverage controls
# ANVIL_TH_CODE_STEP=0.6              # with the sandbox on, the plan review makes a step a code_agent step above this probability
# ANVIL_TH_MIN_RESOLVED_SHARE=0.5     # the source plan stops a build early only below this share of required needs with a source
# ANVIL_RATE_LIMIT_PATTERN=          # a regular expression for the rate limit messages of your sources. A test that fails with such a message has no score
# ANVIL_TIMEOUT_TOKENS_PER_SEC=40     # the time limit of a model request grows with its token budget: budget / this rate (never below ANVIL_REQUEST_TIMEOUT_MS)
# ANVIL_TIMEOUT_RETRIES=1             # how many times a request that hit its time limit runs again
# Library (docs/LIBRARY.md): classes, examples, and lessons for new builds
# ANVIL_LIBRARY_EXAMPLES=on           # off: no examples and no lessons (the class is still found)
# ANVIL_LIBRARY_DOMAINS=finance,currency_exchange,...   # the known domains. A build can add a new one
# ANVIL_TH_EXAMPLE_MATCH=0.6          # the minimum similarity of a library agent to be an example
# ANVIL_TH_EXAMPLE_MIN_SCORE=0.85     # the minimum score of an example (its quality must also be "passed")
# ANVIL_TH_LESSON_MATCH=0.5          # the minimum probability that a lesson of the domain applies to the new task
# ANVIL_LIBRARY_MAX_EXAMPLES=2        # the most examples for one build
# ANVIL_LIBRARY_MAX_CANDIDATES=8      # the most library agents that Jev compares with a new task
# ANVIL_LIBRARY_EXAMPLE_CHARS=4000    # the most characters of one example in a prompt
# ANVIL_LIBRARY_MAX_LESSONS=60        # the most lessons that one domain keeps
# ANVIL_LIBRARY_LESSONS_IN_PROMPT=8   # the most lessons in one prompt
# ANVIL_LIBRARY_LESSON_MAX_AGE_DAYS=120   # older lessons are not used
# ANVIL_CODE_PROGRAM_CACHE=on         # a code_agent step keeps its working program and runs it again without a model call (off: a new program for each run)
# ANVIL_CRITIC_EVIDENCE_CHARS=16000   # the most characters of test evidence (outputs and traces of the failed tests) in one critic prompt
# ANVIL_SOURCE_RETRY_ROUNDS=1          # when no candidate source gives the data of a need, the model proposes new candidates this many times
# ANVIL_SW_SLOW_MS=8000              # a source that answers slower than this in the probe gets ANVIL_SW_SLOW_FACTOR
# ANVIL_SW_SLOW_FACTOR=0.7           # the score factor for a slow source (it can time out when the agent runs)
# Live data sources (docs/LIVE_DATA.md)
# ANVIL_LIVE_RETRIES=2                # new attempts for a transient failure of a GET request
# ANVIL_LIVE_BACKOFF_MS=800           # the first wait before a new attempt (it doubles)
# ANVIL_LIVE_MAX_RETRY_AFTER_MS=15000 # a longer Retry-After is a rate limit: no wait
# ANVIL_LIVE_CACHE=eval               # cache GET answers in evaluation runs (eval), in all runs (all), or never (off)
# ANVIL_LIVE_CACHE_TTL_MS=600000
# ANVIL_HOST_HEADERS={"api.github.com":{"Authorization":"Bearer ${GITHUB_TOKEN}"}}   # headers for an exact host
# ANVIL_TH_TRIGGER_ASKED=0.5          # the minimum probability that the request asks for the trigger of the analysis (below it, the agent starts manually)
# Server
# ANVIL_HOST=127.0.0.1                # 0.0.0.0 in a container
# ANVIL_API_TOKEN=                    # when set, each /api and /mcp request needs "Authorization: Bearer <token>". Only an event stream accepts ?token=.
# Triggers and webhooks (docs/TRIGGERS.md)
# ANVIL_TRIGGER_QUEUE_MAX=100         # the most waiting events for each trigger. A full queue rejects an event with 429.
# ANVIL_TRIGGER_QUEUE_TTL_MS=86400000 # a waiting event older than this does not start a run
# ANVIL_WEBHOOK_AUTH=either           # hmac: only signed requests. token: only the secret header. either: one of the two.
# ANVIL_WEBHOOK_TOLERANCE_MS=300000   # the time window of a signed request. Outside it, the request is a replay.
# ANVIL_WEBHOOK_MAX_BODY_BYTES=1000000
# ANVIL_WEBHOOK_DEDUPE_TTL_MS=86400000   # the same delivery id in this time does not start a second run
# ANVIL_WEBHOOK_ID_HEADERS=idempotency-key,x-anvil-delivery,x-request-id,x-github-delivery,webhook-id,x-webhook-id
# ANVIL_WEBHOOK_DEDUPE_MAX=1000       # the delivery ids that each trigger keeps
# ANVIL_EFFECTS_TTL_MS=604800000      # how long the record of a done action stays (docs/EFFECTS.md)
# ANVIL_EFFECTS_PER_TURN=1            # the most actions of one tool in one turn of a conversation. 0: no limit.
# ANVIL_SECRETS_KEY=                  # the key of the secrets that a person enters on the Connections page (docs/SECRETS.md). Make one with: openssl rand -hex 32
# SLACK_WEBHOOK_URL=                  # the incoming webhook of the send_slack step (docs/SEND.md). You can also set it on the Connections page.
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD= SMTP_FROM= SMTP_SECURE=false   # the SMTP server of the send_email step
# ANVIL_GATE_BIND=127.0.0.1           # the address of the package gate (0.0.0.0 in a container)
# ANVIL_GATE_TARGET_HOST=host.docker.internal   # how the gate sidecar reaches the package gate
# ANVIL_UNATTENDED=off                # on: no person is there. Runs approve human_approval steps and skip human_input steps at once, with a record. The builder asks no questions and adds no human steps.
# ANVIL_RULES_MAX_ACCEPTANCE=6        # the most rule judges (from a policy) in the acceptance of one agent (docs/POLICY.md)
# ANVIL_RULES_MAX_TESTS=3             # the most extra tests that try to break a rule of the policy
# ANVIL_PROFILE=default               # fast: fewer evolve rounds, a lower evaluation budget, fewer harness attempts, and shorter timeouts. A variable that you set still wins.
# ANVIL_TOOL_DATA_CHARS=4000          # the most characters of tool data (mock start data, results of list tools) that testgen sees (docs/TESTS.md)
# ANVIL_COMPOSE_RETRIES=1             # when the repair loop cannot fix a draft, compose writes a new draft this many times
# ANVIL_EVAL_SMOKE_MIN_SCORE=0.5      # a failed smoke test stops the other tests only when its score is below this value
# ANVIL_EVAL_REPEATS=1                # pass^k: the runs of each test in the evaluation rounds of evolve (docs/SELECTION.md)
# ANVIL_SELECT_REPEATS=3              # pass^k: the runs of each test in the selection of best-of-N
# ANVIL_BEST_OF=off                   # on: each build is best-of-N with the builder models (docs/SELECTION.md)
# ANVIL_BUILD_MODELS=z-ai/glm-5.3-flash,deepseek/deepseek-v4.1-flash
# ANVIL_SELECT_JUDGE_MODEL=moonshotai/kimi-k3   # decides between candidates with close scores
# ANVIL_SELECT_MARGIN=0.05            # a lead larger than this value wins without the judge
# ANVIL_SELECT_MAX_TESTS=12           # the most tests in the shared suite (given tests always stay)
# ANVIL_SELECT_GIVEN_WEIGHT=2         # the weight of a given test in the selection
# ANVIL_CANDIDATE_TIMEOUT_MS=1800000  # a candidate that takes longer is out, and its build stops
# ANVIL_CANDIDATE_GRACE_MS=180000     # when two candidates are ready, the others have this much more time
# ANVIL_TH_ACTION_GATE=0.6            # the action gate (docs/GATE.md): a confirmation or a rule below this probability blocks the action
# ANVIL_HEALTH_EVERY=1d               # health checks of live data agents (docs/HEALTH.md): the interval for one agent. off turns them off.
# ANVIL_HEALTH_MIN_SCORE=0.6          # an agent with a lower score in a check is broken
# ANVIL_HEALTH_MAX_DROP=0.25          # an agent whose score falls more than this value below its last evaluation is broken
# ANVIL_HEALTH_BUDGET_USD=0.3         # the most money for one check
# ANVIL_HEALTH_EVOLVE=off             # on: a newly broken agent starts evolve. The fix is a draft version that a person publishes.
# ANVIL_HEALTH_HISTORY=30             # the checks that the history of one agent keeps
# ANVIL_MAX_RETRY_TOKENS=32000        # an answer that used its token budget for reasoning runs again with a larger budget, up to this
# ANVIL_RETRY_REASONING_SHARE=0.4     # in that new attempt, the reasoning gets at most this share of the budget (the third attempt turns the reasoning off)
# ANVIL_LIVE_USAGE_MS=2000            # how often the cost of nested runs goes to the parent run while they work (docs/RUNS.md)
# ANVIL_TH_EVOLVE_PASS_DROP=0         # the pass rate loss that an evolve candidate may have. A higher score with fewer passed tests does not win.
