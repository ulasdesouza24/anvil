# The hosted Anvil API (docs/HOSTING.md). Copy to deploy/hosted/.env on the server.
# Each value below is a secret: make each one with  openssl rand -hex 32
ANVIL_SESSION_SECRET=
ANVIL_SECRETS_KEY=
# The address of the web app (Vercel). A pattern with * is allowed for preview deployments.
ANVIL_CORS_ORIGINS=https://*.vercel.app
# The public address of this API (for webhook and MCP URLs).
ANVIL_PUBLIC_URL=https://anvil-api.example.com
# The server has no OpenRouter key: each user adds an own key in Settings.
